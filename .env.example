# Copy to .env (git-ignored) and adjust. docker compose reads it automatically; start.ps1 also loads it
# into the environment of the backend it launches. Spring Boot itself does not read .env files.

# --- PostgreSQL (docker compose) ---------------------------------------------------------------
POSTGRES_DB=finguard
POSTGRES_USER=finguard_user
POSTGRES_PASSWORD=finguard_pass
POSTGRES_HOST_PORT=5433

# --- Backend (Spring Boot) ------------------------------------------------------------------------
# These override the dev-profile defaults. They are REQUIRED when SPRING_PROFILES_ACTIVE=prod.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/finguard
SPRING_DATASOURCE_USERNAME=finguard_user
SPRING_DATASOURCE_PASSWORD=finguard_pass
# At least 32 bytes. Generate one, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
# Shared secret between backend and AI service (header X-Internal-Token). Leave empty for local development
# (AI_ENV=dev). With AI_ENV=staging|prod the AI service refuses to start without it, and the backend's prod
# profile refuses to start without it: use the same random value of at least 32 characters for both, e.g.
#   openssl rand -base64 48
AI_INTERNAL_TOKEN=
# Set to the OLD secret while rotating (the AI service then accepts both); clear it afterwards.
# AI_INTERNAL_TOKEN_PREVIOUS=
# SPRING_PROFILES_ACTIVE=prod

# --- AI service -----------------------------------------------------------------------------------
AI_HOST_PORT=8000
AI_LOG_LEVEL=INFO
# dev (default) | staging | prod. Anything but dev requires AI_INTERNAL_TOKEN.
AI_ENV=dev
