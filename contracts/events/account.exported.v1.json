{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finguard.ai/contracts/events/account.exported.v1.json",
  "title": "com.finguard.account.exported.v1",
  "description": "Emitted when a user exports their account data (JSON or CSV). Recorded in append-only audit_log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "schema_version",
    "source",
    "time",
    "subject",
    "tenant",
    "trace_id",
    "data"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "const": "com.finguard.account.exported" },
    "schema_version": { "const": 1 },
    "source": { "type": "string" },
    "time": { "type": "string", "format": "date-time" },
    "subject": { "type": "string" },
    "tenant": { "type": "string" },
    "trace_id": { "type": ["string", "null"] },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "totalRecords", "exportedAt"],
      "properties": {
        "format": { "type": "string", "enum": ["JSON", "CSV"] },
        "totalRecords": { "type": "integer", "minimum": 0 },
        "exportedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}

